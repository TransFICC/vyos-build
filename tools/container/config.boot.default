system {
    host-name vyos
    login {
        user vyos {
            authentication {
                encrypted-password "*"
                plaintext-password ""
            }
            level admin
        }
    }
    syslog {
        global {
            facility all {
                level info
            }
            facility protocols {
                level debug
            }
        }
    }
    ntp {
        server "time1.vyos.net"
        server "time2.vyos.net"
        server "time3.vyos.net"
        vrf mgmt
    }
    console {
        device ttyS0 {
            speed 115200
        }
    }
    config-management {
        commit-revisions 100
    }
}

service {
    lldp {
        interface all {
        }
    }
    ssh {
    }
    dns {
        forwarding {
            allow-from '127.0.0.0/24'
            listen-address '127.0.0.1'
            negative-ttl '5'
        }
    }
}

vrf {
    bind-to-all
    name mgmt {
        table 100
    }
}

interfaces {
    ethernet eth0 {
        address dhcp
        vrf mgmt
    }
    ethernet eth1 {
    }
    ethernet eth2 {
    }
    ethernet eth3 {
    }
    loopback lo {
    }
}
